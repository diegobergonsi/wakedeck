<?xml version="1.0" encoding="utf-8"?>
<!-- Round press highlight for icon buttons. Replaces the launcher's default square one. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40808080">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
